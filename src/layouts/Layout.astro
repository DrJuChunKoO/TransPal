---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ToasterHost from "../components/ToasterHost.tsx";
import { getImagePath } from "astro-opengraph-images";
import { markdownToPlainText, truncatePlainText } from "../utils/markdownText";
export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImageDescription?: string;
  ogUrl?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: object;
  keywords?: string;
  author?: string;
}

const { url, site } = Astro;
const {
  title = "TransPal — 葛如鈞委員逐字稿平台",
  description = "TransPal 是立委葛如鈞（寶博士）的公開對話逐字稿平台，收錄質詢、演講與公聽會紀錄，推動政治透明與公民監督。 | Official speech transcript platform of Taiwan Legislator Ju-Chun Ko (JC Ko).",
  ogTitle,
  ogDescription,
  ogImageDescription,
  ogUrl,
  ogType = "website",
  structuredData,
  keywords = "對話, 逐字稿, 公開透明, 對話紀錄, 葛如鈞, 寶博士, 立法委員, 質詢, TransPal, Ju-Chun Ko",
  author = "葛如鈞 Ju-Chun Ko",
} = Astro.props;

// Generate canonical URL if not provided
const canonicalUrl = ogUrl || new URL(Astro.url.pathname, Astro.site).href;

const openGraphImageUrl = getImagePath({ url, site });
const metaDescription = truncatePlainText(markdownToPlainText(description));
const metaOgDescription = truncatePlainText(
  markdownToPlainText(ogDescription || description),
);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="theme-color"
      content="#ffffff"
      id="theme-color-light"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1C1C1C"
      id="theme-color-dark"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="theme-color" content="#ffffff" id="theme-color-dynamic" />

    <!-- Prevent FOUC with theme detection script -->
    <script is:inline>
      (function () {
        function getThemePreference() {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme) return savedTheme;

          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          return prefersDark ? "dark" : "light";
        }

        const theme = getThemePreference();
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Favicon and app icons -->
    <link rel="icon" href="/icon.png" />

    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO meta tags -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content={author} />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph meta tags -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={metaOgDescription} />
    {
      ogImageDescription && (
        <meta
          name="transpal:og-image-description"
          content={ogImageDescription}
        />
      )
    }
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:alt" content={ogTitle || title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="TransPal — 葛如鈞委員逐字稿" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter Card meta tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={metaOgDescription} />
    <meta name="twitter:image" content={openGraphImageUrl} />
    <meta name="twitter:image:alt" content={ogTitle || title} />
    <meta name="twitter:site" content="@dAAAb" />
    <meta name="twitter:creator" content="@dAAAb" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="TransPal RSS Feed"
      href={new URL("/rss.xml", site).href}
    />

    <!-- Structured Data -->
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-N8CTYQPL0W"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-N8CTYQPL0W");
    </script>

    <title>{title}</title>
  </head>
  <body
    class="font-inter flex min-h-screen flex-col text-gray-950 dark:bg-[#1C1C1C] dark:text-gray-50"
  >
    <!-- Skip to main content link for screen readers -->
    <a
      href="#main-content"
      class="sr-only z-50 rounded-md bg-blue-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:outline-none"
    >
      跳至主要內容
    </a>

    <Nav />
    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>
    <Footer />
    <ToasterHost client:load />
  </body>
</html>

<style is:global>
  .font-inter {
    font-family: "Inter", system-ui, sans-serif;
  }
</style>
